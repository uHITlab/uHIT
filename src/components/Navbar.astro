---
const navItems = [
  { label: "About", href: "#about" },
  { label: "Research", href: "#research" },
  { label: "Services", href: "#services" },
  { label: "Publications", href: "#publications" },
  { label: "People", href: "#people" },
];
---

<header class="relative z-20">
  <nav class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-10">
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 text-brand-blue-dark">
      <span class="flex h-10 w-10 items-center justify-center rounded-md bg-brand-blue-dark text-sm font-bold text-white">
        uHIT
      </span>
      <span class="hidden text-lg font-bold tracking-tight sm:inline">
        uHIT
      </span>
    </a>

    <ul class="hidden items-center gap-8 lg:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-[15px] font-semibold text-brand-blue transition-colors hover:text-brand-blue-dark"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <button
        type="button"
        aria-label="Search"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-brand-gray text-brand-blue-dark transition-colors hover:bg-brand-gray-light"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
      </button>
      <button
        type="button"
        aria-label="Toggle menu"
        class="flex h-10 w-10 items-center justify-center rounded-md text-brand-blue-dark lg:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div class="hidden border-t border-white/10 bg-brand-blue-dark text-white sm:block">
    <div class="mx-auto flex max-w-6xl items-center justify-end gap-6 px-4 py-2 text-xs font-semibold sm:px-6 lg:px-10">
      <a href="#current" class="opacity-90 transition-opacity hover:opacity-100">Current Students</a>
      <a href="#parents" class="opacity-90 transition-opacity hover:opacity-100">Parents &amp; Families</a>
      <a href="#faculty" class="opacity-90 transition-opacity hover:opacity-100">Faculty &amp; Staff</a>
      <a href="#alumni" class="opacity-90 transition-opacity hover:opacity-100">Alumni</a>
    </div>
  </div>
</header>
