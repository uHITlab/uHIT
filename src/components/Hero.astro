---
interface Props {
  title: string;
  breadcrumb?: string;
}

const { title, breadcrumb = "Home / User-centered Health Information Technology" } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-blue-dark">
  <div class="relative h-[60vh] min-h-[420px] max-h-[720px] w-full">
    <div
      class="absolute inset-0 bg-[repeating-linear-gradient(45deg,#3a3a3a_0px,#3a3a3a_2px,#4a4a4a_2px,#4a4a4a_4px)] opacity-60"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/30 to-black/80" aria-hidden="true"></div>

    <div class="absolute inset-x-0 bottom-0 mx-auto w-full max-w-6xl px-4 pb-10 sm:px-6 lg:px-10 lg:pb-14">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-white/70">
        {breadcrumb}
      </p>
      <h1 class="max-w-3xl text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
        {title}
      </h1>
    </div>
  </div>
</section>
